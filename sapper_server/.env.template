# Runtime environment: dev or pro
ENVIRONMENT='dev'

# MySQL
MYSQL_HOST='127.0.0.1'
MYSQL_PORT=3306
MYSQL_USER='root'
MYSQL_PASSWORD='replace-with-your-database-password'
MYSQL_DATABASE='sapper'

