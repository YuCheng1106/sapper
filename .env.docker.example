# Copy this file to .env before running Docker Compose.
ENVIRONMENT=dev
TZ=Asia/Shanghai
BIND_HOST=127.0.0.1

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=sapper
MYSQL_USER=sapper
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_EXPOSE_PORT=3306

TOKEN_SECRET_KEY=replace-with-a-random-token-secret
OPERA_LOG_ENCRYPT_SECRET_KEY=replace-with-a-64-character-hex-secret

OPENAI_MODEL=gpt-4o-mini
OPENAI_KEY=
OPENAI_KEY_LIST=[]
OPENAI_BASE_URL=https://api.openai.com/v1
DOUBAO_KEY=

SAPPER_SERVER_PORT=8006
SAPPER_BACKEND_PORT=8007
SAPPER_WEB_PORT=8008
PUBLIC_FILE_URL=http://localhost:8008/server/files
EMBEDDING_MODEL_HOST_PATH=./embed_model

# Optional integrations
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_LINUX_DO_CLIENT_ID=
OAUTH2_LINUX_DO_CLIENT_SECRET=
OAUTH2_AI_JXNU_URL=
OAUTH2_AI_JXNU_AES_KEY=
SECRET_ID=
SECRET_KEY=
REGION=
COS_SESSION_TOKEN=
XFYUN_APP_ID=
XFYUN_SECRET_KEY=
ROBOT_SERVICE_URL=
ROBOT_SERVICE_TOKEN=
ROBOT_DEFAULT_ID=
