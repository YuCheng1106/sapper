# Runtime environment: dev or pro
ENVIRONMENT='dev'

# Database
DATABASE_TYPE='mysql'
DATABASE_HOST='127.0.0.1'
DATABASE_PORT=3306
DATABASE_USER='root'
DATABASE_PASSWORD='replace-with-your-database-password'
DATABASE_SCHEMA='sapper'

# Redis
REDIS_HOST='127.0.0.1'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0

# Authentication and audit-log encryption
TOKEN_SECRET_KEY='replace-with-a-random-token-secret'
OPERA_LOG_ENCRYPT_SECRET_KEY='replace-with-a-random-hex-secret'

# Optional OAuth providers
OAUTH2_GITHUB_CLIENT_ID=''
OAUTH2_GITHUB_CLIENT_SECRET=''
OAUTH2_LINUX_DO_CLIENT_ID=''
OAUTH2_LINUX_DO_CLIENT_SECRET=''
OAUTH2_AI_JXNU_URL=''
OAUTH2_AI_JXNU_AES_KEY=''

# Celery
CELERY_BROKER_REDIS_DATABASE=1
CELERY_BACKEND_REDIS_DATABASE=2
CELERY_RABBITMQ_HOST='127.0.0.1'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'

# Optional object storage
SECRET_ID=''
SECRET_KEY=''
REGION=''

# Optional robot integration
ROBOT_SERVICE_URL=''
ROBOT_SERVICE_TOKEN=''
ROBOT_DEFAULT_ID=''

# Service URLs
SAPPER_BACKEND_URL='http://localhost:8007/api/v1/'
SAPPER_SERVER_URL='http://localhost:8006/server/api/v1/'
